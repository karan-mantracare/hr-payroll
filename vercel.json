{
  "rewrites": [
    {
      "source": "/",
      "destination": "/public/portal.html"
    },
    {
      "source": "/hr-payroll/keka/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/hr-payroll/keka/(.*)",
      "destination": "/public/$1"
    },
    {
      "source": "/hr-payroll/keka",
      "destination": "/public/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
